# Copy to .env and adjust as needed. This file is committed; .env is not.

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL — matches docker-compose.yml.
#
# Port 5433, not 5432: a native PostgreSQL service runs on this machine and
# owns 5432. Pointing here guarantees we talk to the Docker container and
# never to the Windows install.
DATABASE_URL="postgresql://medinv:medinv_dev@localhost:5433/medinv?schema=public"

# Throwaway database Prisma replays migrations into when diffing. Same
# container, separate database name; Prisma creates and drops it.
SHADOW_DATABASE_URL="postgresql://medinv:medinv_dev@localhost:5433/medinv_shadow?schema=public"

# Business timezone. All timestamps are stored UTC; nightly jobs and all
# "days" arithmetic resolve against this zone so "nightly" means nightly
# locally. Iraq is UTC+3 with no DST.
BUSINESS_TIMEZONE=Asia/Baghdad

# JWT. Two DIFFERENT secrets so a leaked access secret cannot mint refresh
# tokens. Both are validated as min 32 chars at boot, so a placeholder left
# here fails loudly instead of producing forgeable tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-random-bytes-base64url
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# First admin. There is no API route that creates an admin, so seeding is the
# only path. Re-seeding NEVER resets an existing admin's password.
# Leave SEED_ADMIN_PASSWORD unset to skip the admin seed entirely.
# In production set it out of band and remove it afterwards.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma-separated), e.g.
#   CORS_ORIGINS=https://admin.example.com
# The admin app is web-only, so without this the browser blocks every request.
# Outside production an empty value also permits any localhost port, because
# `flutter run -d chrome` picks a new one each launch. In production an empty
# value means no cross-origin access at all.
CORS_ORIGINS=

# Dedicated database for the e2e and integration suites. They truncate tables
# between tests, so pointing them at DATABASE_URL destroys the seeded admin
# and anything else being worked with. test/global-setup.ts refuses to run if
# this equals DATABASE_URL.
TEST_DATABASE_URL="postgresql://medinv:medinv_dev@localhost:5433/medinv_test?schema=public"

# Image uploads. Stored in the database (media_files), so no folder is needed.
MAX_UPLOAD_BYTES=5242880

# Nightly jobs (spec §8): auto-decrement, estimates, alerts, expiry warnings,
# hot deals, ledger check — 00:30 in business.timezone. "false" disables them.
JOBS_ENABLED=true

# Push notifications (optional). Paste a Firebase service-account JSON on one
# line to enable FCM; without it every notification is still stored and shown
# in the apps, just not pushed to phones.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
