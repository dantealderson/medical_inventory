{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"],
    "sourceMap": true,
    // Sources span src/, test/ and prisma/, so the project root is the honest
    // root. Not strictly required now that tests run through Vitest/swc, but
    // TypeScript 6 fails with TS5011 whenever a tool invokes tsc on a single
    // file without it, so this stays as cheap insurance.
    // tsconfig.build.json overrides it with ./src, so `nest build` still emits
    // dist/main.js rather than dist/src/main.js.
    "rootDir": ".",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  }
}
