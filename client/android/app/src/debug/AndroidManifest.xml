<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks cleartext http:// by default, which is exactly what
         a local development backend serves. Without this the app cannot reach
         http://10.0.2.2:3000 and reports only a generic connection failure.

         Debug-only on purpose: release builds must stay HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
